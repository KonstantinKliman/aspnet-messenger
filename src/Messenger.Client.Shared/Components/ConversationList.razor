@using Messenger.Contracts.Dtos.Conversations
@inject ChatApi Api
@inject AuthService Auth

<div class="flex h-full flex-col bg-white">
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
        <h1 class="text-lg font-semibold">Чаты</h1>
        <div class="flex items-center gap-2">
            <button @onclick="OpenNewChat"
                    class="rounded-full p-2 text-gray-600 hover:bg-gray-100 transition"
                    title="Новый чат">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 4v16m8-8H4" />
                </svg>
            </button>
            <button @onclick="HandleLogout"
                    class="rounded-full p-2 text-gray-600 hover:bg-gray-100 transition"
                    title="Выйти">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
            </button>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto">
        @if (_loading)
        {
            <div class="p-4 text-center text-sm text-gray-400">Загрузка…</div>
        }
        else if (_conversations.Count == 0)
        {
            <div class="p-8 text-center text-sm text-gray-400">
                Нет диалогов. Нажми «+», чтобы начать переписку.
            </div>
        }
        else
        {
            @foreach (var c in _conversations)
            {
                <button @onclick="() => OnSelect.InvokeAsync(c.Id)"
                        class="@RowClass(c.Id)">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-medium text-blue-700">
                        @Initials(c.Peer?.DisplayName)
                    </div>
                    <div class="min-w-0 flex-1 text-left">
                        <div class="flex items-baseline justify-between gap-2">
                            <span class="truncate font-medium text-gray-900">
                                @(c.Peer?.DisplayName ?? "Без имени")
                            </span>
                            @if (c.LastMessage is not null)
                            {
                                <span class="shrink-0 text-xs text-gray-400">
                                    @FormatTime(c.LastMessage.CreatedAt)
                                </span>
                            }
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="truncate text-sm text-gray-500">
                                @(c.LastMessage?.Content ?? "Нет сообщений")
                            </span>
                            @if (c.UnreadCount > 0)
                            {
                                <span class="flex h-5 min-w-[1.25rem] shrink-0 items-center justify-center rounded-full bg-blue-600 px-1.5 text-xs font-medium text-white">
                                    @c.UnreadCount
                                </span>
                            }
                        </div>
                    </div>
                </button>
            }
        }
    </div>
</div>

@code {
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
    [Parameter] public EventCallback OnNewChat { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    private List<ConversationListItemDto> _conversations = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Reload();

    public async Task Reload()
    {
        _loading = true;
        try { _conversations = await Api.GetConversationsAsync(); }
        finally { _loading = false; }
        StateHasChanged();
    }

    private Task OpenNewChat() => OnNewChat.InvokeAsync();
    private Task HandleLogout() => OnLogout.InvokeAsync();

    private string RowClass(Guid id)
    {
        var baseClass = "flex w-full items-center gap-3 px-4 py-3 transition hover:bg-gray-50";
        return id == SelectedId ? $"{baseClass} bg-blue-50" : baseClass;
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
            : char.ToUpper(parts[0][0]).ToString();
    }

    private static string FormatTime(DateTimeOffset time)
    {
        var local = time.ToLocalTime();
        var now = DateTimeOffset.Now;
        if (local.Date == now.Date) return local.ToString("HH:mm");
        if (local.Date == now.Date.AddDays(-1)) return "вчера";
        return local.ToString("dd.MM");
    }
}