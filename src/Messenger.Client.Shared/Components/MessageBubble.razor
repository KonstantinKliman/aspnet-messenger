@using Messenger.Contracts.Dtos.Messages
<div class="@WrapClass">
    <div class="@BubbleClass">
        <div class="whitespace-pre-wrap break-words text-sm">@Message.Content</div>
        <div class="@TimeClass">@Message.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MessageDto Message { get; set; } = default!;
    [Parameter, EditorRequired] public bool IsOwn { get; set; }

    private string WrapClass => IsOwn
        ? "mb-2 flex justify-end"
        : "mb-2 flex justify-start";

    private string BubbleClass => IsOwn
        ? "max-w-[75%] rounded-2xl rounded-br-md bg-blue-600 px-3 py-2 text-white"
        : "max-w-[75%] rounded-2xl rounded-bl-md bg-white px-3 py-2 text-gray-900 shadow-sm";

    private string TimeClass => IsOwn
        ? "mt-1 text-right text-[10px] text-blue-100"
        : "mt-1 text-right text-[10px] text-gray-400";
}